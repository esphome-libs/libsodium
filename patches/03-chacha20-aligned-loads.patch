+    return *(const uint32_t *)p;
+#else
+    const uint8_t *b = (const uint8_t *)p;
+    return ((uint32_t)b[0])
+         | ((uint32_t)b[1] << 8)
+         | ((uint32_t)b[2] << 16)
+         | ((uint32_t)b[3] << 24);
+#endif
+}
