ESP8266: keep the Ed25519 verification tables in flash.

Bi[8] (the 8 odd multiples of the base point, about 960 bytes) is read as
int32 limbs, so it only needs the flash attribute. The small-order blocklist
(224 bytes) is compared byte by byte, so on the ESP8266 paths it is stored and
compared as little-endian words, keeping the constant-time accumulation. Each
table gets its own .irom.text.* section: sharing .irom.text with base_packed
would keep that 12 KB table whenever verification is linked.

diff --git a/src/libsodium/crypto_core/ed25519/ref10/ed25519_ref10.c b/src/libsodium/crypto_core/ed25519/ref10/ed25519_ref10.c
index 0655c2a3..468ba2b0 100644
--- a/src/libsodium/crypto_core/ed25519/ref10/ed25519_ref10.c
+++ b/src/libsodium/crypto_core/ed25519/ref10/ed25519_ref10.c
@@ -14,6 +14,14 @@
 
 #include "sodium/esphome_yield.h"
 
+/* ESPHome: verification-only tables in ESP8266 flash, read as aligned words; own
+   sections, so using them does not keep base_packed in the shared .irom.text */
+#ifdef SODIUM_ESPHOME_ESP8266
+#define ED25519_FLASH_ATTR(name) __attribute__((aligned(4), section(".irom.text." name)))
+#else
+#define ED25519_FLASH_ATTR(name)
+#endif
+
 static inline uint64_t
 load_3(const unsigned char *in)
 {
@@ -778,7 +786,7 @@ void
 ge25519_double_scalarmult_vartime(ge25519_p2 *r, const unsigned char *a,
                                   const ge25519_p3 *A, const unsigned char *b)
 {
-    static const ge25519_precomp Bi[8] = {
+    static const ge25519_precomp ED25519_FLASH_ATTR("ed25519_bi") Bi[8] = {
 #ifdef HAVE_TI_MODE
 # include "fe_51/base2.h"
 #else
@@ -1127,6 +1135,46 @@ ge25519_is_canonical(const unsigned char *s)
     return 1 - (c & d & 1);
 }
 
+#ifdef SODIUM_ESPHOME_ESP8266_PATHS
+int
+ge25519_has_small_order(const unsigned char s[32])
+{
+    /* ESPHome: the 7 small-order encodings as little-endian words, so the table
+       can live in ESP8266 flash, which only allows aligned 32-bit reads */
+    static const uint32_t ED25519_FLASH_ATTR("ed25519_blocklist") blacklist[7][8] = {
+        { 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000 },
+        { 0x00000001, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000 },
+        { 0x8f95e826, 0xb027b2c2, 0x89f4c345, 0xf098eff2, 0x05acdfd5, 0x3933c6d3, 0x880238b1, 0x05fc536d },
+        { 0x706a17c7, 0x4fd84d3d, 0x760b3cba, 0x0f67100d, 0xfa53202a, 0xc6cc392c, 0x77fdc74e, 0x7a03ac92 },
+        { 0xffffffec, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0x7fffffff },
+        { 0xffffffed, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0x7fffffff },
+        { 0xffffffee, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, 0x7fffffff },
+    };
+    uint32_t      c[7] = { 0 };
+    uint32_t      sw[8];
+    unsigned char cb;
+    unsigned int  k;
+    size_t        i, j;
+
+    for (j = 0; j < 8; j++) {
+        sw[j] = LOAD32_LE(s + 4 * j);
+    }
+    sw[7] &= 0x7fffffff;
+    for (j = 0; j < 8; j++) {
+        for (i = 0; i < 7; i++) {
+            c[i] |= sw[j] ^ blacklist[i][j];
+        }
+    }
+    k = 0;
+    for (i = 0; i < 7; i++) {
+        /* fold to a byte that is zero exactly when the word is, then as upstream */
+        c[i] |= c[i] >> 16;
+        cb = (unsigned char) (c[i] | (c[i] >> 8));
+        k |= (cb - 1);
+    }
+    return (int) ((k >> 8) & 1);
+}
+#else
 int
 ge25519_has_small_order(const unsigned char s[32])
 {
@@ -1182,6 +1230,7 @@ ge25519_has_small_order(const unsigned char s[32])
     }
     return (int) ((k >> 8) & 1);
 }
+#endif
 
